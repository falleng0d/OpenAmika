# ── Secrets: never commit ────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
brain/.env*
settings.json
config/tools.json
config/messengers.json
.modal.toml
.modal/

# ── Private runtime data (memories, usage ledger, logs, machine-local state) ──
memory_f/
brain/memories/
backups/
logs/
*.log
*.log.*
*.pid
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-journal
*.db-wal
*.db-shm
config/build_f.json
config/word_replace.json
config/seed.json
config/ollama.json
config/voice_map.json
servers/openamika-iot/devices.json
servers/openamika-iot/scenes.json
avatar/stage/
tests/output/
controls_verification.json

# ── Python environments made by scripts/setup_core.py (venvs in envs\<name>) ──
envs/

# ── Large model weights and licensed assets (bring your own / download) ──
speech/models/*
!speech/models/DOWNLOAD.md
avatar/models/*
!avatar/models/README.md
# Protect weights/reference recordings and generated voice clips outside the usual model folders too.
*.ckpt
*.pth
*.pt
*.safetensors
*.onnx
*.gguf
*.bin
*.moc3
*.wav
*.flac
*.mp3
*.ogg
*.opus

# ── Third-party stacks you install next to OpenAmika (never part of this repo) ──
IoT/zigbee2mqtt/
IoT/data/
IoT/logs/
Hermes/
Nanomuse/
Vanadis_Evo/

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
tests/browser/node_modules/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/

# ── OS / editor noise ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.bak
*.tmp
*.orig

# ── Local TLS material ───────────────────────────────────────────────
certs/
*.pem
*.key

# voice server: only the server code and its docs are in git. scripts/setup_tts.py builds the rest
# (.venv/, GPT-SoVITS/, ffmpeg/, nltk_data/, Speakers/, cache/, downloads/) from public sources.
vendor/tts-engine/*
!vendor/tts-engine/main.py
!vendor/tts-engine/requirements-tts.txt
!vendor/tts-engine/README.md
!vendor/tts-engine/LICENSE
!vendor/tts-engine/THIRD_PARTY_NOTICES.md
